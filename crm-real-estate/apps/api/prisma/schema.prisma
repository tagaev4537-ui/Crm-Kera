// Prisma schema — CRM для менеджеров по продажам недвижимости

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
}

enum PropertyStatus {
  AVAILABLE   // в продаже
  RESERVED    // бронь
  SOLD        // продана
  ARCHIVED    // снята с продажи
}

enum DealStage {
  NEW           // новая заявка
  CONTACTED     // связались
  VIEWING       // показ
  NEGOTIATION   // переговоры / бронь
  DEAL          // сделка оформляется
  WON           // сделка закрыта успешно
  LOST          // сделка потеряна
}

enum Currency {
  USD
  KGS
}

enum EntityType {
  CLIENT
  PROPERTY
  DEAL
}

model User {
  id                  String    @id @default(cuid())
  fullName            String
  username            String    @unique
  passwordHash        String
  role                Role      @default(MANAGER)
  isActive            Boolean   @default(true)
  phone               String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  mustChangePassword  Boolean   @default(false)
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  clients      Client[]      @relation("ClientManager")
  deals        Deal[]        @relation("DealManager")
  comments     Comment[]
  dealHistory  DealHistory[]
  refreshTokens RefreshToken[]

  @@index([username])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Client {
  id         String   @id @default(cuid())
  fullName   String
  phone      String
  email      String?
  source     String?  // откуда клиент: сайт, звонок, рекомендация, соцсети...
  status     String   @default("NEW") // NEW, IN_PROGRESS, CLIENT, LOST
  managerId  String
  manager    User     @relation("ClientManager", fields: [managerId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  deals    Deal[]

  @@index([managerId])
  @@index([fullName])
  @@index([phone])
}

model Property {
  id           String         @id @default(cuid())
  title        String
  address      String
  district     String?
  rooms        Int
  areaM2       Float
  floor        Int?
  totalFloors  Int?
  priceUsd     Float
  status       PropertyStatus @default(AVAILABLE)
  description  String?
  photos       String[]       @default([])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  deals    Deal[]

  @@index([status])
  @@index([district])
}

model Deal {
  id                 String    @id @default(cuid())
  title              String
  clientId           String
  client             Client    @relation(fields: [clientId], references: [id])
  propertyId         String?
  property           Property? @relation(fields: [propertyId], references: [id])
  managerId          String
  manager            User      @relation("DealManager", fields: [managerId], references: [id])
  stage              DealStage @default(NEW)
  amountUsd          Float
  currency           Currency  @default(USD)
  exchangeRateUsed   Float?    // курс USD->KGS на момент создания/закрытия сделки
  probability        Int       @default(20)
  expectedCloseDate  DateTime?
  closedAt           DateTime?
  lostReason         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  history  DealHistory[]

  @@index([stage])
  @@index([managerId])
  @@index([clientId])
}

model DealHistory {
  id        String    @id @default(cuid())
  dealId    String
  deal      Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fromStage DealStage?
  toStage   DealStage
  changedById String
  changedBy   User    @relation(fields: [changedById], references: [id])
  note      String?
  createdAt DateTime  @default(now())

  @@index([dealId])
}

// Comment — полиморфная модель (привязывается к клиенту, квартире или сделке
// через entityType + entityId). Намеренно без FK-связи на entityId, т.к. он
// может ссылаться на разные таблицы; целостность и удаление комментариев
// при удалении родителя обеспечиваются в коде контроллеров.
model Comment {
  id         String     @id @default(cuid())
  text       String
  entityType EntityType
  entityId   String
  authorId   String
  author     User       @relation(fields: [authorId], references: [id])
  createdAt  DateTime   @default(now())

  @@index([entityType, entityId])
}

model ExchangeRate {
  id        String   @id @default(cuid())
  usdToKgs  Float
  setById   String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
